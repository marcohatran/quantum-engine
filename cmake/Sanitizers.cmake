function(quantum_apply_sanitizers target)
    if (NOT (QUANTUM_ENABLE_ASAN OR QUANTUM_ENABLE_UBSAN OR QUANTUM_ENABLE_TSAN))
        return()
    endif()

    set(_flags "")
    if (QUANTUM_ENABLE_ASAN)
        list(APPEND _flags -fsanitize=address -fno-omit-frame-pointer)
    endif()
    if (QUANTUM_ENABLE_UBSAN)
        list(APPEND _flags -fsanitize=undefined -fno-omit-frame-pointer)
    endif()
    if (QUANTUM_ENABLE_TSAN)
        list(APPEND _flags -fsanitize=thread -fno-omit-frame-pointer)
    endif()

    target_compile_options(${target} PRIVATE ${_flags})
    target_link_options(${target}    PRIVATE ${_flags})
endfunction()
