function(quantum_set_simd target)
    if (MSVC)
        target_compile_options(${target} PRIVATE /arch:AVX2)
        target_compile_definitions(${target} PRIVATE QUANTUM_HAS_AVX2=1)
        if (QUANTUM_ENABLE_AVX512)
            target_compile_options(${target} PRIVATE /arch:AVX512)
            target_compile_definitions(${target} PRIVATE QUANTUM_HAS_AVX512=1)
        endif()
    else()
        # On Apple Silicon / ARM we skip x86 SIMD entirely; scalar paths cover correctness.
        if (CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
            target_compile_options(${target} PRIVATE -mavx2 -mbmi2)
            target_compile_definitions(${target} PRIVATE QUANTUM_HAS_AVX2=1)
            if (QUANTUM_ENABLE_AVX512)
                target_compile_options(${target} PRIVATE -mavx512f -mavx512bw -mavx512dq)
                target_compile_definitions(${target} PRIVATE QUANTUM_HAS_AVX512=1)
            endif()
        endif()
    endif()
endfunction()
